// Nome: Investigação de Login Suspeito
// Plataforma: Microsoft Sentinel
// Objetivo: Identificar autenticações recentes realizadas por um usuário.

SigninLogs
| where TimeGenerated >= ago(24h)
| project
    TimeGenerated,
    UserPrincipalName,
    IPAddress,
    AppDisplayName,
    ResultDescription,
    ConditionalAccessStatus,
    Location = tostring(LocationDetails.countryOrRegion)
| sort by TimeGenerated desc
